# Server
PORT=5000
NODE_ENV=development

# Frontend (for email links, CORS). In production use https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Optional: public API URL for server logs in production (e.g. https://api.yourdomain.com)
# API_PUBLIC_URL=

# JWT (required in production - set a strong random secret)
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# MongoDB (required in production - no fallback). For local dev, default is mongodb://localhost:27017/faculty-evaluation
MONGODB_URI=mongodb://localhost:27017/faculty-evaluation

# Email (Nodemailer SMTP). Leave SMTP_HOST/USER/PASS empty to skip sending (welcome/reset emails will no-op)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.com
APP_NAME=Faculty Evaluation System

# Optional: Admin creation script (npm run create-admin)
# ADMIN_EMAIL=admin@cau.edu
# ADMIN_PASSWORD=admin123
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User
