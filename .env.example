# ==================================
# Faculty Evaluation System - Environment Variables
# ==================================

# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ==================================
# General
# ==================================
NODE_ENV=production
COMPOSE_PROJECT_NAME=faculty-eval

# ==================================
# MongoDB Configuration
# ==================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_secure_mongodb_password_here
MONGO_DB=faculty_evaluation
MONGO_PORT=27017

# ==================================
# Redis Configuration
# ==================================
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379

# ==================================
# Backend Configuration
# ==================================
BACKEND_PORT=5000

# JWT Authentication
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ==================================
# Email Configuration (Nodemailer)
# ==================================
# Gmail example:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM="Faculty Evaluation System <noreply@cau.edu>"

# For other providers:
# - Outlook: smtp-mail.outlook.com, port 587
# - Yahoo: smtp.mail.yahoo.com, port 587
# - SendGrid: smtp.sendgrid.net, port 587
# - Mailgun: smtp.mailgun.org, port 587

# ==================================
# Frontend Configuration
# ==================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==================================
# Production URLs (when deployed)
# ==================================
# FRONTEND_URL=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
