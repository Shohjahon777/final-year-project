{
  "name": "faculty-evaluation-backend",
  "version": "1.0.0",
  "description": "Backend API for Faculty Evaluation System",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "seed:config": "ts-node src/scripts/seed-config.ts",
    "create-admin": "ts-node src/scripts/create-admin.ts",
    "seed": "ts-node src/scripts/seed-all.ts"
  },
  "dependencies": {
    "express": "^4.21.1",
    "mongoose": "^8.7.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-validator": "^7.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "typescript": "^5.6.3",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.2",
    "eslint": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0"
  }
}
